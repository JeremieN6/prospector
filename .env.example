DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
SESSION_SECRET="change-me-long-random-secret"
ENCRYPTION_SECRET="change-me-long-random-secret"
REDIS_URL="redis://127.0.0.1:6379"
